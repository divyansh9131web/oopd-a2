#include "bookmgmt/Catalog.h"

#include <algorithm>
#include <cctype>
#include <stdexcept>
#include "bookmgmt/Book.h"
#include "bookmgmt/EBook.h"
#include "bookmgmt/Journal.h"

#include "bookmgmt/Exceptions.h"


#include "bookmgmt/AudioBook.h"
#include "bookmgmt/EBook.h"
#include "bookmgmt/Thesis.h"
#include <fstream>
#include <iomanip>
#include <sstream>

namespace bookmgmt {

namespace {
std::string lower(std::string s) {
    std::transform(s.begin(), s.end(), s.begin(),
                   [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
    return s;
}
}  // namespace

Resource& Catalog::add(std::unique_ptr<Resource> r) {
    if (!r) throw std::invalid_argument("cannot add a null resource");
    const std::string id = r->id();
    if (items_.count(id)) throw DuplicateIdError(id);
    Entry& e = items_[id];
    e.resource = std::move(r);
    return *e.resource;
}

bool Catalog::contains(const std::string& id) const { return items_.count(id) > 0; }

Resource* Catalog::find(const std::string& id) {
    auto it = items_.find(id);
    return it == items_.end() ? nullptr : it->second.resource.get();
}

const Resource* Catalog::find(const std::string& id) const {
    auto it = items_.find(id);
    return it == items_.end() ? nullptr : it->second.resource.get();
}

Resource& Catalog::get(const std::string& id) {
    if (Resource* r = find(id)) return *r;
    throw NotFoundError(id);
}

const Resource& Catalog::get(const std::string& id) const {
    if (const Resource* r = find(id)) return *r;
    throw NotFoundError(id);
}

void Catalog::remove(const std::string& id) {
    if (items_.erase(id) == 0) throw NotFoundError(id);
}

int Catalog::holdings(const std::string& id) const {
    auto it = items_.find(id);
    if (it == items_.end()) throw NotFoundError(id);
    return it->second.holdings;
}

void Catalog::addHoldings(const std::string& id, int units) {
    auto it = items_.find(id);
    if (it == items_.end()) throw NotFoundError(id);
    if (it->second.holdings + units < 0)
        throw std::invalid_argument("holdings cannot become negative");
    it->second.holdings += units;
}

std::vector<const Resource*> Catalog::where(
    const std::function<bool(const Resource&)>& pred) const {
    std::vector<const Resource*> out;
    for (const auto& [id, entry] : items_)
        if (pred(*entry.resource)) out.push_back(entry.resource.get());
    return out;
}

std::vector<const Resource*> Catalog::all() const {
    return where([](const Resource&) { return true; });
}

std::vector<const Resource*> Catalog::byCategory(ResourceCategory c) const {
    return where([c](const Resource& r) { return r.category() == c; });
}

std::vector<const Resource*> Catalog::searchTitle(const std::string& text) const {
    const std::string needle = lower(text);
    return where([&needle](const Resource& r) {
        return lower(r.title()).find(needle) != std::string::npos;
    });
}

std::vector<const Resource*> Catalog::searchAuthor(
    const std::string& author) const {
    const std::string needle = lower(author);

    return where([&needle](const Resource& r) {
        const auto* book = dynamic_cast<const Book*>(&r);
        if (!book) return false;

        for (const auto& name : book->authors()) {
            if (lower(name).find(needle) != std::string::npos)
                return true;
        }
        return false;
    });
}

std::vector<const Resource*> Catalog::searchISBN(
    const std::string& isbn) const {
    return where([&isbn](const Resource& r) {
        if (const auto* book = dynamic_cast<const Book*>(&r))
            return book->isbn() == isbn;

        if (const auto* ebook = dynamic_cast<const EBook*>(&r))
            return ebook->isbn() == isbn;

        if (const auto* journal = dynamic_cast<const Journal*>(&r))
            return journal->issn() == isbn;

        return false;
    });
}

std::vector<const Resource*> Catalog::searchYearRange(
    int startYear, int endYear) const {
    if (startYear > endYear)
        throw std::invalid_argument("start year cannot exceed end year");

    return where([startYear, endYear](const Resource& r) {
        return r.year() >= startYear && r.year() <= endYear;
    });
}


void Catalog::saveToFile(const std::string& filename) const {
    std::ofstream out(filename);
    if (!out) throw std::runtime_error("Cannot open catalogue file for writing");

    for (const auto& [id, entry] : items_) {
        const Resource& r = *entry.resource;
        out << static_cast<int>(r.category()) << ' '
            << std::quoted(r.id()) << ' ' << std::quoted(r.title()) << ' '
            << std::quoted(r.publisher()) << ' ' << r.year() << ' '
            << r.unitPrice().minorUnits() << ' ' << entry.holdings << ' ';

        if (const auto* b = dynamic_cast<const Book*>(&r)) {
            out << std::quoted(b->isbn()) << ' ' << b->edition() << ' '
                << static_cast<int>(b->binding()) << ' '
                << b->authors().size();
            for (const auto& a : b->authors()) out << ' ' << std::quoted(a);
        } else if (const auto* e = dynamic_cast<const EBook*>(&r)) {
            out << std::quoted(e->accessUrl()) << ' '
                << static_cast<int>(e->license()) << ' '
                << e->platformFee().minorUnits() << ' '
                << std::quoted(e->isbn()) << ' '
                << static_cast<int>(e->format()) << ' '
                << e->drmProtected() << ' ' << e->authors().size();
            for (const auto& a : e->authors()) out << ' ' << std::quoted(a);
        } else if (const auto* a = dynamic_cast<const AudioBook*>(&r)) {
            out << std::quoted(a->accessUrl()) << ' '
                << static_cast<int>(a->license()) << ' '
                << a->platformFee().minorUnits() << ' '
                << std::quoted(a->narrator()) << ' '
                << a->durationMinutes();
        } else if (const auto* j = dynamic_cast<const Journal*>(&r)) {
            out << std::quoted(j->issn()) << ' ' << j->issuesPerYear()
                << ' ' << j->subscriptionYears();
        } else if (const auto* t = dynamic_cast<const Thesis*>(&r)) {
            out << std::quoted(t->university()) << ' '
                << std::quoted(t->degree()) << ' '
                << std::quoted(t->supervisor());
        } else if (const auto* e = dynamic_cast<const ElectronicResource*>(&r)) {
            out << std::quoted(e->accessUrl()) << ' '
                << static_cast<int>(e->license()) << ' '
                << e->platformFee().minorUnits();
        } else {
            throw std::runtime_error("Unsupported resource type");
        }
        out << '\n';
        if (!out) throw std::runtime_error("Error writing catalogue file");
    }
}

void Catalog::loadFromFile(const std::string& filename) {
    std::ifstream in(filename);
    if (!in) throw std::runtime_error("Cannot open catalogue file for reading");

    Catalog loaded;
    std::string line;
    int lineNo = 0;

    while (std::getline(in, line)) {
        ++lineNo;
        if (line.empty()) continue;

        std::istringstream row(line);
        int type, year, holdings;
        std::int64_t price;
        std::string id, title, publisher;

        if (!(row >> type >> std::quoted(id) >> std::quoted(title)
                  >> std::quoted(publisher) >> year >> price >> holdings)
            || holdings < 0) {
            throw std::runtime_error("Malformed catalogue line " +
                                     std::to_string(lineNo));
        }

        auto money = Money::fromMinor(price);
        std::unique_ptr<Resource> resource;

        if (type == static_cast<int>(ResourceCategory::Book)) {
            std::string isbn;
            int edition, binding;
            std::size_t n;
            if (!(row >> std::quoted(isbn) >> edition >> binding >> n))
                throw std::runtime_error("Malformed Book record");
            std::vector<std::string> authors(n);
            for (auto& a : authors)
                if (!(row >> std::quoted(a)))
                    throw std::runtime_error("Malformed Book authors");
            if (binding < 0 || binding > 1)
                throw std::runtime_error("Invalid Book binding");
            resource = std::make_unique<Book>(
                id, title, authors, isbn, publisher, year, money, edition,
                static_cast<Binding>(binding));
        } else if (type == static_cast<int>(ResourceCategory::EBook)) {
            std::string url, isbn;
            int license, format, drm;
            std::int64_t fee;
            std::size_t n;
            if (!(row >> std::quoted(url) >> license >> fee
                      >> std::quoted(isbn) >> format >> drm >> n))
                throw std::runtime_error("Malformed EBook record");
            std::vector<std::string> authors(n);
            for (auto& a : authors)
                if (!(row >> std::quoted(a)))
                    throw std::runtime_error("Malformed EBook authors");
            if (license < 0 || license > 1 || format < 0 || format > 2)
                throw std::runtime_error("Invalid EBook enum value");
            resource = std::make_unique<EBook>(
                id, title, authors, isbn, publisher, year, money, url,
                static_cast<EBookFormat>(format), drm != 0,
                static_cast<LicenseModel>(license), Money::fromMinor(fee));
        } else if (type == static_cast<int>(ResourceCategory::AudioBook)) {
            std::string url, narrator;
            int license, duration;
            std::int64_t fee;
            if (!(row >> std::quoted(url) >> license >> fee
                      >> std::quoted(narrator) >> duration))
                throw std::runtime_error("Malformed AudioBook record");
            if (license < 0 || license > 1)
                throw std::runtime_error("Invalid AudioBook license");
            resource = std::make_unique<AudioBook>(
                id, title, publisher, year, money, url, narrator, duration,
                static_cast<LicenseModel>(license), Money::fromMinor(fee));
        } else if (type == static_cast<int>(ResourceCategory::Journal)) {
            std::string issn;
            int issues, years;
            if (!(row >> std::quoted(issn) >> issues >> years))
                throw std::runtime_error("Malformed Journal record");
            resource = std::make_unique<Journal>(
                id, title, publisher, year, money, issn, issues, years);
        } else if (type == static_cast<int>(ResourceCategory::Thesis)) {
            std::string university, degree, supervisor;
            if (!(row >> std::quoted(university) >> std::quoted(degree)
                      >> std::quoted(supervisor)))
                throw std::runtime_error("Malformed Thesis record");
            resource = std::make_unique<Thesis>(
                id, title, publisher, year, money, university, degree, supervisor);
        } else if (type == static_cast<int>(ResourceCategory::ElectronicResource)) {
            std::string url;
            int license;
            std::int64_t fee;
            if (!(row >> std::quoted(url) >> license >> fee)
                || license < 0 || license > 1)
                throw std::runtime_error("Malformed ElectronicResource record");
            resource = std::make_unique<ElectronicResource>(
                id, title, publisher, year, money, url,
                static_cast<LicenseModel>(license), Money::fromMinor(fee));
        } else {
            throw std::runtime_error("Unknown resource type on line " +
                                     std::to_string(lineNo));
        }

        std::string extra;
        if (row >> extra)
            throw std::runtime_error("Unexpected extra data on line " +
                                     std::to_string(lineNo));

        loaded.add(std::move(resource));
        loaded.addHoldings(id, holdings);
    }

    if (!in.eof()) throw std::runtime_error("Error reading catalogue file");
    items_ = std::move(loaded.items_);
}

}  // namespace bookmgmt
